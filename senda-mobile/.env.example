# Copia este archivo a .env y complétalo.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave anon (pública). Nunca pongas aquí la service_role.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Dirección del backend. En un teléfono físico usa la IP local de tu computadora.
EXPO_PUBLIC_API_URL=http://localhost:3000
