# Conexión a PostgreSQL (Supabase).
# DATABASE_URL: pooler en modo transacción (puerto 6543) para la app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: pooler en modo sesión (puerto 5432) para las migraciones de Prisma.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Clave de OpenAI para NOVA. Si se deja vacía, NOVA responde con un mensaje simulado.
OPENAI_API_KEY=

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Supabase Auth: el backend verifica con esto los tokens que envía la app.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Mensajes por día con NOVA en el plan gratuito (por defecto 10). Los mensajes de crisis nunca se bloquean.
NOVA_DAILY_LIMIT=10
